# OILTRACE AI Environment Configuration
APP_ENV=development
DATA_MODE=simulation
OILTRACE_DEMO_SEED=26143
DATABASE_URL=sqlite:///./data/oiltrace.db
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# AI & Detection Model
MODEL_PATH=models/oiltrace_demo_unet.pt
MODEL_VERSION=1.0.0-demo
MODEL_THRESHOLD=0.42

# Lagrangian Drift Physics
DEFAULT_WINDAGE_COEFFICIENT=0.03
DEFAULT_PARTICLE_COUNT=100
DEFAULT_INTEGRATION_TIMESTEP_MINUTES=30
DEFAULT_HINDCAST_HOURS=18
DEFAULT_FORECAST_HOURS=48

# AIS Screening & Attribution Weights
DEFAULT_AIS_RADIUS_KM=50
DEFAULT_AIS_TEMPORAL_WINDOW_HOURS=2
WEIGHT_PROXIMITY=0.35
WEIGHT_TEMPORAL=0.25
WEIGHT_TRAJECTORY=0.20
WEIGHT_HEADING=0.10
WEIGHT_CONTINUITY=0.10

# Real Data Adapters (Optional - for Operational Mode)
SATELLITE_PROVIDER=simulation
SATELLITE_API_URL=
SATELLITE_API_KEY=
CMEMS_API_URL=
CMEMS_API_KEY=
ERA5_API_KEY=
AIS_DATA_PATH=data/real/ais/

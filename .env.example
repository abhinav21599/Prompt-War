# ==============================================================================
# OILTRACE AI - Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="OILTRACE AI"
APP_VERSION="1.0.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"

# Primary Production Database (PostgreSQL with PostGIS)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://oiltrace_admin:secure_password@localhost:5432/oiltrace_db"
# Fallback / Lightweight local development SQLite URL:
# DATABASE_URL="sqlite:///./data/oiltrace.db"

# Data Pipeline Mode: "real" (Production default) or "simulation" (Offline / Demo)
DATA_MODE="real"
DEFAULT_DATA_MODE="real"
SIMULATION_SEED_ENABLED=false

# Machine Learning Segmentation Model Checkpoint
MODEL_VERSION="1.0.0"
MODEL_THRESHOLD=0.42
MODEL_PATH=""
PREPROCESSING_VERSION="1.2.0"

# Physics Simulation & Lagrangian Particle Parameters
DEFAULT_WINDAGE_COEFFICIENT=0.03
DEFAULT_PARTICLE_COUNT=100
DEFAULT_INTEGRATION_TIMESTEP_MINUTES=30
DEFAULT_HINDCAST_HOURS=18
DEFAULT_FORECAST_HOURS=48
DEFAULT_AIS_RADIUS_KM=50.0
DEFAULT_AIS_TEMPORAL_WINDOW_HOURS=2.0
DEFAULT_TRACK_GAP_THRESHOLD_MINUTES=60

# Attribution Engine Weights (Normalized sum = 1.0)
WEIGHT_PROXIMITY=0.35
WEIGHT_TEMPORAL=0.25
WEIGHT_TRAJECTORY=0.20
WEIGHT_HEADING=0.10
WEIGHT_CONTINUITY=0.10

# Indian Official Remote Sensing & Oceanographic Providers
# ISRO / NRSC Bhoonidhi Open Data API (https://bhoonidhi-api.nrsc.gov.in/)
BHOONIDHI_USERNAME=""
BHOONIDHI_PASSWORD=""
BHOONIDHI_API_TOKEN=""

# ISRO MOSDAC (Meteorological and Oceanographic Satellite Data Archival Centre)
MOSDAC_TOKEN=""

# European Space Agency / Copernicus Data Space Ecosystem (CDSE)
COPERNICUS_USERNAME=""
COPERNICUS_PASSWORD=""

# Copernicus Marine Environment Monitoring Service (CMEMS) Hydrodynamics
CMEMS_USERNAME=""
CMEMS_PASSWORD=""

# Copernicus Climate Data Store (CDS / ERA5 10m Wind Fields)
CDS_API_KEY=""

# Automatic Identification System (AIS) Live Provider API
AIS_API_KEY=""

REPORT_OUTPUT_DIR="data/processed/reports"
MAX_UPLOAD_SIZE_MB=512
